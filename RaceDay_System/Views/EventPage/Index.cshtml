@model IEnumerable<RaceDay_System.Models.Event>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <!-- Alert Messages (Success / Error) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Upcoming Race Events</h1>

        @if (User.IsInRole("Organiser"))
        {
            <a asp-action="Create" class="btn btn-primary">Create New Event</a>
        }
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Venue</th>
                <th>Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Venue</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (item.Status == "Upcoming")
                        {
                            <span class="badge bg-success">@item.Status</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@item.Status</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-info text-white">Details</a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Participant"))
                            {
                                <form asp-action="Enrol" asp-route-eventId="@item.EventId" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-bold">Enrol Now</button>
                                </form>
                            }
                            else if (User.IsInRole("Organiser"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-primary">Edit</a>

                                <form asp-action="Delete" asp-route-id="@item.EventId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this event?');">
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>