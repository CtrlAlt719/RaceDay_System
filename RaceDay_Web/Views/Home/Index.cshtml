@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center d-flex flex-column justify-content-center align-items-center" style="min-height: 60vh;">

    <h1 class="display-3 fw-bold mb-3" style="color: var(--primary-blue);">
        Ready for the Race? 🏁
    </h1>

    <p class="lead text-muted mb-5" style="font-size: 1.5rem;">
        Join the community. Organise events. Track your results.
    </p>

    <div class="mt-4">
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            if (User.IsInRole("Organiser"))
            {
                <a asp-controller="Events" asp-action="Index" class="btn btn-success btn-lg px-5 py-3 me-3">Go to Dashboard</a>
            }
            else
            {
                <a asp-controller="Events" asp-action="Browse" class="btn btn-success btn-lg px-5 py-3 me-3">Find an Event</a>
            }
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 py-3">Get Started</a>
        }
    </div>
</div>