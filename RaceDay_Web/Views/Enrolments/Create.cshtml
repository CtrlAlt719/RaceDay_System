@{
    ViewData["Title"] = "Enrol in Event";
}

<h2 class="mt-4">Enrol in @ViewBag.EventName</h2>
<hr />

<form asp-action="Enrol" method="post">
    <input type="hidden" name="eventId" value="@ViewBag.EventId" />

    <div class="mb-3">
        <label class="form-label">Select Category</label>
        <select name="categoryId" class="form-select" required>
            <option value="">-- Select a Category --</option>

            @if (ViewBag.Categories != null)
            {
                foreach (var cat in ViewBag.Categories)
                {
                    // CHANGED TO CAPITAL LETTERS HERE:
                    <option value="@cat.CategoryId">@cat.Name - @cat.DistanceKm km (R@cat.EntryFee)</option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success">Confirm Enrolment</button>
    <a asp-action="Browse" asp-controller="Events" class="btn btn-secondary">Cancel</a>
</form>