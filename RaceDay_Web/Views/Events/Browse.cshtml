@model List<RaceDay_Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";
}

<h2 class="mt-4">Upcoming Events</h2>
<hr />

<div class="row">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@ev.Name</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@ev.EventDate.ToString("dd MMM yyyy")</h6>
                        <p class="card-text">@ev.Description</p>
                        <p class="card-text"><strong>Venue:</strong> @ev.Venue</p>

                        <!-- Enrol Button -->
                        <a asp-controller="Enrolments" asp-action="Create" asp-route-eventId="@ev.EventId" class="btn btn-primary w-100">Enrol Now</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info">No events found or you are not authorized to view them.</div>
        </div>
    }
</div>

