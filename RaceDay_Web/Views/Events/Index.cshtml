@model List<RaceDay_Web.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<h2 class="mt-4">Manage Events</h2>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Create New Event</a>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Venue</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var ev in Model)
                {
                    <tr>
                        <td>@ev.Name</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Venue</td>
                        <td>
                            <span class="badge @(ev.Status == "Upcoming" ? "bg-primary" : "bg-secondary")">
                                @ev.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="AddCategory" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-primary">Add Category</a>
                            <a asp-action="Enrolments" asp-route-eventId="@ev.EventId" class="btn btn-sm btn-info text-white">View Enrolments</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No events found. Create one to get started!</td>
                </tr>
            }
        </tbody>
    </table>
</div>b 