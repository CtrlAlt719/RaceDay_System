@model RaceDay_Web.Models.CreateCategoryViewModel

@{
    ViewData["Title"] = "Add Category";
}

<h2 class="mt-4">Add Category to Event</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="AddCategory" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Hidden field to keep track of which event we are adding to -->
            <input type="hidden" asp-for="EventId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Category Name (e.g. 10km)</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DistanceKm" class="form-label">Distance (km)</label>
                <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Capacity" class="form-label">Max Capacity</label>
                <input asp-for="Capacity" class="form-control" type="number" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
                <input asp-for="EntryFee" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="EntryFee" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Save Category</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}